# LLM providers and model selection are configured from the Ambient Agent UI.
# Stored credentials live in the gitignored workspace/llm/secrets.json file.
# Individual credential fields may reference deployment environment variables.

# Docker Compose runs the knowledge graph in Neo4j. Change this password for
# any shared or remotely reachable deployment. Set GRAPH_MIGRATE_SQLITE=1 for
# one startup to import an existing workspace/graph.db without deleting it.
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=ambient-agent-dev
NEO4J_DATABASE=neo4j
GRAPH_MIGRATE_SQLITE=0

# Browser Widget Controllers use the isolated iframe transport by default.
# Origins are exact, comma-separated Frontend origins accepted for one-time
# Runtime tickets. Change these for a remote or HTTPS deployment; never use *.
AMBIENT_FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Sensitive Host-only reads also require a loopback peer. Docker Compose
# supplies its bridge range automatically. Leave blank for direct Host use;
# add only an explicit trusted proxy/container CIDR when deployment requires it.
AMBIENT_TRUSTED_HOST_PEERS=
# Leave blank to derive http(s)://<frontend-host>:8001/frame.html. Behind a
# reverse proxy, set the complete public browser-reachable frame URL instead.
WIDGET_FRAME_URL=
# Optional public Backend base used by the Frontend for HTTP and WebSocket
# traffic. Keep blank for http(s)://<frontend-host>:8000, or set the external
# HTTPS reverse-proxy base (a path prefix is supported).
VITE_API_BASE_URL=
VITE_WIDGET_UI_TRANSPORT=iframe

# The old server-Chromium pixel transport remains available for one release.
# Compose wires this Unix socket automatically. Set the Vite variable above to
# "pixels" only for an emergency compatibility rollback.
WIDGET_RUNTIME_SOCKET_PATH=/run/ambient-widget-runtime/runtime.sock
# Upgrades: replace any older value of 16 in an existing .env with 4 unless
# the 768MiB/192-PID Runtime limit has been raised and load-tested as well.
WIDGET_RUNTIME_MAX_CONTEXTS=4
# Close Chromium after the last Pixel/smoke context stays idle for this long.
WIDGET_RUNTIME_IDLE_TIMEOUT_MS=60000
# Production Compose/Dev Container enable the isolated first-frame staging
# smoke test. Set to 0 only for host-only backend development without Docker.
WIDGET_RUNTIME_SMOKE_ENABLED=1

# Keep background work bounded on an 8GB host. The per-App scheduler limit
# remains one; raise the global limit only after increasing the Backend budget.
RUNNER_MAX_CONCURRENCY=1

# Skill discovery always includes the bundled catalog. Optionally add a local
# two-file Market and/or a version-1 GitHub catalog configuration. In Docker,
# place both below ./workspace and use their /app/workspace paths. GitHub
# entries must pin a 40-character commit, expected SKILL.md SHA-256, and
# files=["SKILL.md"]; they still install disabled and quarantined.
# Opt-in Anthropic catalog: host path backend/catalogs/anthropic.json; Docker
# path /app/backend/catalogs/anthropic.json.
SKILL_MARKET_DIR=
SKILL_CATALOG_CONFIG=

# OpenCode Developer Agent CLI Configuration
# In Docker / DevContainer, the latest opencode binary is automatically pulled
# via the official installer and placed at /usr/local/bin/opencode, so the
# default value below works out of the box.
# For a global installation on the host:        opencode
# For a local submodule / dev build:            bun run --cwd vendor/opencode dev
OPENCODE_COMMAND=opencode

# OpenCode Developer Agent execution timeout (in seconds)
# Default is 600.0 (10 minutes)
OPENCODE_TIMEOUT=600.0

# Codex is installed on demand from the Coding Agent UI. Its CLI and native
# login are persisted in the managed coding-agent Docker volume. Set this only
# to override the managed binary with an existing executable.
CODEX_COMMAND=
# The production image pins this bridge. Host-only development can install
# @agentclientprotocol/codex-acp@1.1.7 and set, for example, "codex-acp".
CODEX_ACP_COMMAND=
CODEX_TIMEOUT=600.0

# Failed Widget drafts stay isolated and non-executable so retry can resume
# verification without regenerating code. Default: 604800 seconds (7 days).
FAILED_STAGING_RETENTION_SECONDS=604800
