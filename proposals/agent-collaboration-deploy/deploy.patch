+            launch(client, pair)
+            active = app.state.tunnels[pair["node_id"]]
+            original = active.socket.send_json
+            completed = []
+
+            async def blocked_write(message):
+                await asyncio.sleep(0.1)
+                completed.append(True)
+                await original(message)
